{
  "name": "uniflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-ocr-assets.mjs && next build && node scripts/fix-segment-prefetch.mjs && node scripts/generate-sw.mjs",
    "start": "npx serve out -l tcp://0.0.0.0:4000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e && npm run test:offline && npm run test:features && npm run test:responsive",
    "icons": "node scripts/generate-icons.mjs",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#4F46E5\" --iconBackgroundColorDark \"#4F46E5\" --splashBackgroundColor \"#F7F7FB\" --splashBackgroundColorDark \"#0E0C1D\"",
    "cap:sync": "npm run build && cap sync",
    "android:open": "npm run cap:sync && cap open android",
    "android:run": "npm run cap:sync && cap run android",
    "android:apk": "npm run cap:sync && node scripts/gradle.mjs assembleDebug",
    "android:release": "npm run cap:sync && node scripts/gradle.mjs bundleRelease assembleRelease",
    "ios:open": "npm run cap:sync && cap open ios",
    "test:offline": "node scripts/e2e-offline.mjs",
    "deploy:netlify": "npm run build && npx --yes netlify-cli deploy --dir=out --prod",
    "test:features": "node scripts/e2e-features.mjs",
    "test:responsive": "node scripts/e2e-responsive.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@hookform/resolvers": "^5.9.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
